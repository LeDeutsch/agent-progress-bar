{
  "name": "agent-progress-bar",
  "displayName": "Agent Progress Bar",
  "description": "A progress bar and the time left, in the status bar, for the long tasks your AI agents run in the background. Any agent or script reports its progress by writing a small JSON file.",
  "version": "0.1.0",
  "publisher": "ludwigdinspel",
  "author": "Ludwig Junior Dinspel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeDeutsch/agent-progress-bar.git"
  },
  "bugs": {
    "url": "https://github.com/LeDeutsch/agent-progress-bar/issues"
  },
  "homepage": "https://github.com/LeDeutsch/agent-progress-bar#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai agent",
    "agent",
    "progress",
    "progress bar",
    "time remaining",
    "eta",
    "background task",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentProgress.showPanel",
        "title": "Show Panel",
        "category": "Agent Progress"
      },
      {
        "command": "agentProgress.clearFinished",
        "title": "Clear Finished Tasks",
        "category": "Agent Progress"
      },
      {
        "command": "agentProgress.openFolder",
        "title": "Open Progress Folder",
        "category": "Agent Progress"
      }
    ],
    "configuration": {
      "title": "Agent Progress Bar",
      "properties": {
        "agentProgress.folder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder watched for progress files. Empty: `~/.agent-progress`."
        },
        "agentProgress.staleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "A running task with no update for this many minutes is shown as stalled."
        },
        "agentProgress.keepFinishedMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How many minutes a finished or failed task stays visible."
        },
        "agentProgress.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a task finishes or fails."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/demo.js",
    "package": "npx --yes @vscode/vsce@3.2.1 package"
  }
}
