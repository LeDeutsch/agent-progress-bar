{
  "name": "agent-progress-bar",
  "displayName": "Agent Progress Bar",
  "description": "A progress bar and the time left for the long tasks your AI agents run in the background, in the status bar and in a panel next to the terminal. Works with any agent, command or script.",
  "version": "0.1.3",
  "publisher": "ludwigdinspel",
  "author": "Ludwig Junior Dinspel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeDeutsch/agent-progress-bar.git"
  },
  "bugs": {
    "url": "https://github.com/LeDeutsch/agent-progress-bar/issues"
  },
  "homepage": "https://github.com/LeDeutsch/agent-progress-bar#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai agent",
    "agent",
    "progress",
    "progress bar",
    "time remaining",
    "eta",
    "background task",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "bin": {
    "agent-progress": "bin/agent-progress.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentProgress.showPanel",
        "title": "Show Progress Panel",
        "category": "Agent Progress"
      },
      {
        "command": "agentProgress.clearFinished",
        "title": "Clear Finished Tasks",
        "category": "Agent Progress",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentProgress.openFolder",
        "title": "Open Progress Folder",
        "category": "Agent Progress",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentProgress.addInstructions",
        "title": "Add Agent Instructions",
        "category": "Agent Progress",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentProgress.howItWorks",
        "title": "How It Works",
        "category": "Agent Progress",
        "icon": "$(question)"
      },
      {
        "command": "agentProgress.confirmAdd",
        "title": "Write the Agent Instructions",
        "category": "Agent Progress",
        "icon": "$(check)"
      },
      {
        "command": "agentProgress.cancelAdd",
        "title": "Cancel the Agent Instructions",
        "category": "Agent Progress",
        "icon": "$(close)"
      },
      {
        "command": "agentProgress.openSettings",
        "title": "Open Settings",
        "category": "Agent Progress",
        "icon": "$(gear)"
      },
      {
        "command": "agentProgress.besideTerminal",
        "title": "Show Beside the Terminal",
        "category": "Agent Progress",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "agentProgress.ownTab",
        "title": "Show in Its Own Tab",
        "category": "Agent Progress",
        "icon": "$(layout-panel)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "agentProgress",
          "title": "Agent Progress",
          "icon": "media/progress.svg"
        }
      ]
    },
    "views": {
      "agentProgress": [
        {
          "type": "webview",
          "id": "agentProgress.view",
          "name": "Agent Progress"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentProgress.clearFinished",
          "when": "view == agentProgress.view",
          "group": "navigation"
        },
        {
          "command": "agentProgress.openFolder",
          "when": "view == agentProgress.view",
          "group": "navigation"
        },
        {
          "command": "agentProgress.howItWorks",
          "when": "view == agentProgress.view",
          "group": "navigation"
        },
        {
          "command": "agentProgress.besideTerminal",
          "when": "view == agentProgress.view && !agentProgress.besideTerminal",
          "group": "navigation"
        },
        {
          "command": "agentProgress.ownTab",
          "when": "view == agentProgress.view && agentProgress.besideTerminal",
          "group": "navigation"
        },
        {
          "command": "agentProgress.openSettings",
          "when": "view == agentProgress.view",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "agentProgress.confirmAdd",
          "when": "agentProgress.pending && resourceScheme == agent-progress-preview",
          "group": "navigation@1"
        },
        {
          "command": "agentProgress.cancelAdd",
          "when": "agentProgress.pending && resourceScheme == agent-progress-preview",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentProgress.confirmAdd",
          "when": "agentProgress.pending"
        },
        {
          "command": "agentProgress.cancelAdd",
          "when": "agentProgress.pending"
        },
        {
          "command": "agentProgress.besideTerminal",
          "when": "!agentProgress.besideTerminal"
        },
        {
          "command": "agentProgress.ownTab",
          "when": "agentProgress.besideTerminal"
        }
      ]
    },
    "configuration": {
      "title": "Agent Progress Bar",
      "properties": {
        "agentProgress.folder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder watched for progress files. Empty: `~/.agent-progress`."
        },
        "agentProgress.staleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "A running task with no update for this many minutes is shown as stalled."
        },
        "agentProgress.keepFinishedMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "How many minutes a finished or failed task stays in the list. A line at the bottom of its card empties meanwhile."
        },
        "agentProgress.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a task finishes or fails."
        },
        "agentProgress.deleteFilesAfterHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "Progress files with no update for this many hours are deleted, with the logs the agent-progress command wrote next to them. 0: never."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "demo": "node examples/demo.js",
    "package": "npx --yes @vscode/vsce@3.2.1 package"
  }
}
